PORT=8080

# Firebase service account file (download from Firebase console)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Firestore collection names (defaults used if omitted)
COL_USERS=users
COL_PAIR_CODES=pairCodes
COL_PAYMENT_REQUESTS=paymentRequests

# Request expiry (seconds)
REQUEST_TTL_SECONDS=120

