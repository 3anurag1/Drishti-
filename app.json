{
  "expo": {
    "name": "NetraPay",
    "slug": "netrapay",
    "scheme": "netrapay",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "com.netrapay.app",
      "//googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA", "RECORD_AUDIO", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "NetraPay needs camera access to scan UPI QR codes.",
          "microphonePermission": "NetraPay needs microphone access for voice commands."
        }
      ]
    ]
  }
}

